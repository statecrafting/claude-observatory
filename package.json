{
  "name": "claude-observatory",
  "version": "0.1.0",
  "description": "Filesystem observability for ~/.claude: watcher daemon, event log, semantic classification",
  "type": "module",
  "private": true,
  "bin": {
    "observatory": "./src/index.ts"
  },
  "scripts": {
    "watch": "bun src/index.ts watch",
    "snapshot": "bun src/index.ts snapshot",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p web/tsconfig.json",
    "web:dev": "bunx vite --config web/vite.config.ts",
    "web:build": "bunx vite build --config web/vite.config.ts"
  },
  "spec-spine": {
    "spec": "000-bootstrap"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.2",
    "vite": "^8.2.0"
  }
}
